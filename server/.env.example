DATABASE_URL=postgres://autoflow:autoflow@localhost:5432/autoflow
PORT=3000
# Sätt till true när programmet körs bakom HTTPS
COOKIE_SECURE=false

# SMS: "log" sparar bara meddelandena. "46elks" skickar på riktigt.
SMS_PROVIDER=log
SMS_46ELKS_USERNAME=
SMS_46ELKS_PASSWORD=

# Fordonsuppslag mot extern dataleverantör ({reg} ersätts med regnumret)
VEHICLE_LOOKUP_URL=
VEHICLE_LOOKUP_TOKEN=
